{
  "name": "pi-observational-memory",
  "version": "0.1.2",
  "description": "Pi package for session-local observational memory.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "observational-memory"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "observer-evals": "tsx eval/src/cli/observer-evals.ts",
    "checkpoint-evals": "tsx eval/src/cli/checkpoint-evals.ts",
    "om-evals": "tsx eval/src/cli/om-evals.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^25.9.1",
    "typebox": "*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "tsx": "^4.22.4"
  }
}
